{
  "name": "printforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sqlite": "vitest run --project sqlite",
    "db:seed": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "mailparser": "^3.9.31",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "smtp-server": "^3.19.15",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
