MONGODB_URI=mongodb://localhost:27017/printforge
# Generate a unique secret before production. Never expose it in VITE_* variables.
ADMIN_TOKEN=change-me
PORT=3001
# Static API messages and new order snapshot labels: en or pl (default: en).
APP_LANGUAGE=pl
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173,http://127.0.0.1:4174
