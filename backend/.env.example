# Storage. Unset: SQLite for `npm run dev` (no database server needed) and MongoDB for
# `npm start`. Set DATABASE=sqlite or DATABASE=mongodb to choose explicitly.
# SQLite keeps everything, including uploaded files, in one file.
# DATABASE=sqlite
SQLITE_PATH=data/printforge.sqlite
# Used when DATABASE=mongodb. Local MongoDB: docker compose up -d
MONGODB_URI=mongodb://localhost:27017/printforge
# Generate a unique secret before production. Never expose it in VITE_* variables.
ADMIN_TOKEN=change-me
PORT=3001
# Static API messages and new order snapshot labels: en or pl (default: en).
APP_LANGUAGE=en
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173,http://127.0.0.1:4174

# Emails to customers (status emails and messages from the admin's log book).
# Without SMTP_HOST, development saves them as .eml files in MAIL_OUTBOX_DIR and production
# logs them as failed. MAIL_FROM is required with SMTP_HOST. SMTP_SECURE=true uses TLS from the
# start (usually port 465); otherwise STARTTLS is required whenever SMTP_USER is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=shop@example.com
# SMTP_PASSWORD=change-me
# MAIL_FROM=PrintForge <shop@example.com>
# MAIL_REPLY_TO=shop@example.com
MAIL_OUTBOX_DIR=data/outbox
# External model search. Thingiverse App Token (https://www.thingiverse.com/developers);
# without it only Printables and MakerWorld are searched. Never expose it in VITE_* variables.
THINGIVERSE_TOKEN=
# Sites to search, comma-separated: thingiverse,printables,makerworld (default: all; empty disables).
# MODEL_SEARCH_SOURCES=thingiverse,printables,makerworld
